# Cub de prova per al carregador d'OBJ.
# Cares definides com a QUADRILATERS a proposit: obliga el carregador a
# triangular-les. Cada cara mapeja la textura sencera.

# 8 vertexs (posicions)
v -0.5 -0.5  0.5
v  0.5 -0.5  0.5
v  0.5  0.5  0.5
v -0.5  0.5  0.5
v -0.5 -0.5 -0.5
v  0.5 -0.5 -0.5
v  0.5  0.5 -0.5
v -0.5  0.5 -0.5

# 4 coordenades de textura
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0

# 6 normals, una per cara
vn  0.0  0.0  1.0
vn  0.0  0.0 -1.0
vn  1.0  0.0  0.0
vn -1.0  0.0  0.0
vn  0.0  1.0  0.0
vn  0.0 -1.0  0.0

# 6 cares, en ordre antihorari vistes des de fora
f 1/1/1 2/2/1 3/3/1 4/4/1
f 2/1/3 6/2/3 7/3/3 3/4/3
f 6/1/2 5/2/2 8/3/2 7/4/2
f 5/1/4 1/2/4 4/3/4 8/4/4
f 4/1/5 3/2/5 7/3/5 8/4/5
f 5/1/6 6/2/6 2/3/6 1/4/6
