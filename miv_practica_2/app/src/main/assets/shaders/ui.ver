#version 300 es
layout(location = 0) in vec3 aPosition;   // quad unitario (0..1)
layout(location = 1) in vec2 aTexCoord;

uniform mat4 uModel;           // lleva el quad a su posición/tamaño en píxeles
uniform mat4 uVistaProjeccio;  // píxeles -> NDC (la ortográfica del paso 5)

out vec2 vTexCoord;

void main() {
    vTexCoord = aTexCoord;
    gl_Position = uVistaProjeccio * uModel * vec4(aPosition, 1.0);
}
// TODO (8/10a): vertex shader de la interficie.
//
//   Es el mes senzill de tots els que has escrit. Rep dos atributs, posicio
//   (location 0) i coordenada de textura (location 1), i les dues matrius de
//   sempre, uModel i uVistaProjeccio. Treu la coordenada de textura cap al
//   fragment shader i calcula gl_Position com has fet sempre.
//
//   NO hi ha normal ni matriu normal: un element d'interficie no s'il lumina.
//
//   El que canvia no es el shader, es el que hi entra. La posicio que rep es
//   la del QUAD UNITAT, de (0,0) a (1,1), i es uModel qui el porta a la seva
//   posicio i mida reals en pixels. Reaprofitar el mateix quad per a tots els
//   elements es el que fa que canviar-ne la mida no costi res: no es torna a
//   tocar cap buffer, nomes una matriu.
