#version 300 es

precision highp float;   // abans: mediump

// Ha de coincidir amb Illuminacio.MAX_LLUMS_PUNTUALS. Un array d'un shader ha
// de tenir mida constant de compilacio: GLSL no admet mides variables.
const int MAX_LLUMS_PUNTUALS = 4;

// Aquesta estructura i els noms dels seus camps han de coincidir EXACTAMENT
// amb les cadenes que construeix Illuminacio.aplicaPuntuals(). Obre el fitxer
// i comprova-ho abans d'escriure res.
struct LlumPuntual {
    vec3 posicio;
    vec3 color;
    float intensitat;
    float atenuacioLineal;
    float atenuacioQuadratica;
};
in vec2 vTexCoord;
in vec3 vNormalMon;
in vec3 vPosicioMon;

// noms ja fixats a ObjecteTexturat
uniform sampler2D uTextura;
uniform float uBrillantor;

uniform vec3 uAmbient;
uniform vec3 uPosicioCamera;

uniform vec3  uDireccioLlum;     // cap a on viatja la llum
uniform vec3  uColorLlum;
uniform float uIntensitatLlum;

uniform LlumPuntual uLlumsPuntuals[MAX_LLUMS_PUNTUALS];
uniform int uNombreLlumsPuntuals;

out vec4 fragColor;

vec3 blinnPhong(vec3 N, vec3 V, vec3 L, vec3 colorLlum) {
    float difus = max(dot(N, L), 0.0);

    vec3 H = normalize(L + V);                       // vector medio
    float especular = pow(max(dot(N, H), 0.0), uBrillantor);

    // Sin difuso no hay especular (evita brillos en la cara oscura)
    especular *= step(0.0001, difus);

    return colorLlum * (difus + especular);
}

void main() {
    vec3 N = normalize(vNormalMon);                   // re-normalitzar despres de interpolar
    vec3 V = normalize(uPosicioCamera - vPosicioMon);

    // ambient
    vec3 llum = uAmbient;

    // direccional: l' uniform diu va la llum
    vec3 Ld = normalize(-uDireccioLlum);
    llum += blinnPhong(N, V, Ld, uColorLlum * uIntensitatLlum);

    // puntuals
    for (int i = 0; i < MAX_LLUMS_PUNTUALS; i++) {
        if (i >= uNombreLlumsPuntuals) {
            break;
        }

        vec3 capALlum = uLlumsPuntuals[i].posicio - vPosicioMon;
        float d = length(capALlum);
        vec3 L = capALlum / max(d, 0.0001);           // normalitzar sense dividir per 0

        float atenuacio = 1.0 / (1.0
                + uLlumsPuntuals[i].atenuacioLineal * d
                + uLlumsPuntuals[i].atenuacioQuadratica * d * d);

        vec3 color = uLlumsPuntuals[i].color * uLlumsPuntuals[i].intensitat * atenuacio;
        llum += blinnPhong(N, V, L, color);
    }


    vec4 albedo = texture(uTextura, vTexCoord);
    //fragColor = vec4(N * 0.5 + 0.5, 1.0);
    fragColor = vec4(albedo.rgb * llum, albedo.a);
}
// TODO (3/10): fragment shader amb il luminacio de Blinn-Phong.
//
//   ENTRADES. Les tres sortides del vertex shader, amb els mateixos noms i
//   tipus: coordenada de textura, normal de mon i posicio de mon.
//
//   UNIFORMS. Mira Illuminacio.java per saber els noms exactes:
//     - el sampler de la textura;
//     - el color de la llum ambient;
//     - direccio, color i intensitat de la llum direccional;
//     - l'array de LlumPuntual i quantes n'hi ha de valides;
//     - la posicio de la camera;
//     - l'exponent especular del material.
//
//   EL MODEL D'IL LUMINACIO. Tres components que se sumen:
//
//     AMBIENT: una constant. Representa la llum que ha rebotat per l'escena.
//     Sense ella, tot el que no mira cap a cap llum queda absolutament negre,
//     cosa que a la realitat gairebe no passa mai.
//
//     DIFUS: depen nomes de l'angle entre la normal i la direccio cap a la
//     llum, amb un producte escalar. Es el que dona el volum. Fes max(..., 0.0)
//     o les cares que miren a l'altra banda RESTARAN llum.
//
//     ESPECULAR: el reflex brillant. Amb Blinn-Phong es calcula el vector
//     "mig" entre la direccio cap a la llum i la direccio cap a la camera, i
//     se'n fa el producte escalar amb la normal elevat a l'exponent del
//     material. Per aixo cal saber on es la camera: un reflex depen del punt
//     de vista i es mou quan et mous, a diferencia del difus.
//
//     Compte: el terme especular no sap res de l'orientacio de la cara, de
//     manera que apareixerien brillantors a la cara FOSCA dels objectes. Anul la
//     l'especular quan el difus sigui zero.
//
//   LES DUES MENES DE LLUM:
//
//     DIRECCIONAL: no te posicio ni s'atenua. El uniform diu cap on VIATGEN
//     els raigs, i el calcul necessita el vector contrari, del fragment cap a
//     la llum. Nega'l.
//
//     PUNTUALS: recorre'n l'array. Per a cada una, el vector cap a la llum es
//     la seva posicio menys la posicio del fragment; la seva longitud es la
//     distancia. Normalitza'l dividint per la distancia, pero amb un max()
//     per no dividir per zero si un fragment cau just a sobre de la llum.
//
//     L'atenuacio es   1 / (1 + lineal*d + quadratica*d*d).
//
//     Al bucle, fes que el limit sigui la constant MAX_LLUMS_PUNTUALS i surt
//     amb un break quan passis del nombre real de llums: alguns compiladors
//     antics no accepten limits variables en un for.
//
//   AL FINAL. Mostreja la textura i MULTIPLICA-LA per la llum acumulada.
//   Multiplicar i no sumar es el que fa que una superficie vermella sota llum
//   blava surti gairebe negra: no hi ha vermell per reflectir. Conserva
//   l'alfa de la textura.
//
//   UN CONSELL PER DEPURAR: si no veus res o tot surt negre, escriu de forma
//   provisional la normal com a color (normal * 0.5 + 0.5). Si el model
//   apareix pintat de colors suaus i continus, les normals arriben be i el
//   problema es al calcul de llum. Si surt negre o a trossos, el problema es
//   abans, al TODO 1 o al TODO 2.
